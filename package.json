{
  "name": "gugbab-claude-package",
  "version": "0.0.0",
  "private": true,
  "description": "gugbab 공용 프론트엔드 패키지 모노레포 (@gugbab/*)",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "sb:dev:mui": "bash scripts/storybook-dev.sh mui",
    "sb:dev:radix": "bash scripts/storybook-dev.sh radix",
    "sb:build:mui": "bash scripts/storybook-build.sh mui",
    "sb:build:radix": "bash scripts/storybook-build.sh radix",
    "vr": "bash scripts/storybook-vr.sh",
    "vr:mui": "bash scripts/storybook-vr.sh --project=mui",
    "vr:radix": "bash scripts/storybook-vr.sh --project=radix",
    "vr:update": "bash scripts/storybook-vr.sh --update",
    "vr:update:mui": "bash scripts/storybook-vr.sh --project=mui --update",
    "vr:update:radix": "bash scripts/storybook-vr.sh --project=radix --update",
    "vr:report": "playwright show-report",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@biomejs/biome": "^2.4.12",
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^19.5.0",
    "@gugbab/biome-config": "workspace:*",
    "@gugbab/commitlint-config": "workspace:*",
    "@gugbab/tsconfig": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@storybook/test-runner": "^0.24.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "turbo": "^2.9.14",
    "wait-on": "^9.0.5"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.6",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "joi@>=17.0.0 <17.13.7": "^17.13.7",
      "joi@>=18.0.0 <18.2.6": "^18.2.6",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "shell-quote@<1.9.0": "^1.9.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
