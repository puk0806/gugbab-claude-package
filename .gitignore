_radix-reference/

# Build outputs
dist/
build/
.turbo/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Env — .env.production 등 모든 변형 차단, 예시 파일만 허용
.env
.env.*
!.env.example

# Husky internals (auto-managed)
.husky/_

# Codex local state (user-specific)
.codex/
